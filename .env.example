# Какой источник топологии: mock | tailscale | api
MESHMAP_PROVIDER=mock

# Интервал сбора, секунды
MESHMAP_INTERVAL=5

# Где лежит история (SQLite)
MESHMAP_DB=meshmap.db

# Для provider=api: токен Tailscale (read-only достаточно)
TS_API_TOKEN=
TS_TAILNET=-

# SSH: под каким пользователем открывать SFTP
MESHMAP_SSH_USER=
# Переопределение по хостам: "home-server=root,vps-ams=deploy"
MESHMAP_SSH_USERS=
# Порт SSH/SFTP (если sshd слушает не 22)
MESHMAP_SSH_PORT=22
# Приватный ключ для WinSCP (только .ppk: winscp.com /keygen id_ed25519 /output=id_ed25519.ppk)
MESHMAP_SSH_KEY=
# Проверять SSH-порт (TCP + баннер)
MESHMAP_PROBE_SSH=1
MESHMAP_PROBE_TIMEOUT=1.5

# FileZilla: путь, если стоит не в стандартном месте
MESHMAP_FILEZILLA=
# Разрешить запуск локального клиента из UI
MESHMAP_ALLOW_LAUNCH=1
